# SkyTower-AI Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM API Keys (OPTIONAL - system works without them using rule-based logic)
# =============================================================================
# Choose one:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# Data Sources (OPTIONAL - for enhanced data)
# =============================================================================
# Finnhub - free tier available at https://finnhub.io/
FINNHUB_API_KEY=

# =============================================================================
# MT5 Direct Connection (OPTIONAL - if not using EA)
# =============================================================================
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=PurpleTrading-MT5
MT5_PATH=C:\Program Files\Purple Trading MT5\terminal64.exe
